[Unit]
Description=ComfyUI (LivePortrait / personagem)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=comfy
Group=comfy
WorkingDirectory=/opt/comfy/ComfyUI
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/comfy/venv/bin/python main.py \
  --listen 192.168.15.11 --port 8188 \
  --reserve-vram 3 \
  --preview-method auto
Restart=on-failure
RestartSec=10
# Frigate e a loja têm prioridade
Nice=5
CPUWeight=50
MemoryMax=24G
# Endurecimento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/comfy

[Install]
WantedBy=multi-user.target
